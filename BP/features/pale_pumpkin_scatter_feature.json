{
    "format_version": "1.13.0",

    "minecraft:scatter_feature": {
        "description": {
            "identifier": "fom:pale_pumpkin_scatter_feature"
        },

        "places_feature": "fom:pale_pumpkin_feature",

        "scatter_chance": 60,
        "iterations": "v.flower_patch.size = math.random_integer(3, 6); return math.random_integer(math.pow(v.flower_patch.size, 2) / 4, math.pow(v.flower_patch.size, 2) / 3);",

        "project_input_to_floor": true,
        "x": {
            "distribution": "gaussian",
            "extent": [0, "v.flower_patch.size"]
        },
        "z": {
            "distribution": "gaussian",
            "extent": [0, "v.flower_patch.size"]
        },
        "y": 0
    }
}